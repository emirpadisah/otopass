# Local mode works without external services and persists data under .local-data/.
OTOPASS_DATA_MODE=local

# Set OTOPASS_DATA_MODE=supabase and provide all three values for production.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
OPTIONAL_ENABLE_CAPTCHA=false
