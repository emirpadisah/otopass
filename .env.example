# Development can use local intake data. Production always requires Supabase.
OTOPASS_DATA_MODE=local
OTOPASS_ENABLE_LOCAL_AUTH=false

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public form security
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
RATE_LIMIT_HMAC_SECRET=

# Transactional email
RESEND_API_KEY=
RESEND_FROM_EMAIL=Otopass <notifications@example.com>

# Scheduled maintenance
CRON_SECRET=

# Error monitoring and source maps
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# One-time bootstrap only; remove after npm run bootstrap:admin.
BOOTSTRAP_SUPER_ADMIN_EMAIL=
BOOTSTRAP_SUPER_ADMIN_PASSWORD=
