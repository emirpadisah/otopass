# Development can use local intake data. Production always requires Supabase.
OTOPASS_DATA_MODE=local
OTOPASS_ENABLE_LOCAL_AUTH=false

# Local: http://localhost:3000 | Production: https://www.otokopru.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Dealer custom domains (server-only Vercel REST API access)
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# Public form security
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
RATE_LIMIT_HMAC_SECRET=

# Scheduled maintenance
CRON_SECRET=

# Error monitoring and source maps
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# One-time bootstrap only; remove after npm run bootstrap:admin.
BOOTSTRAP_SUPER_ADMIN_EMAIL=
BOOTSTRAP_SUPER_ADMIN_PASSWORD=
